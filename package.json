{
  "name": "@teddyzhu/auto-launch",
  "version": "6.0.1",
  "description": "Launch node applications or executables at login (Mac, Windows, Linux and FreeBSD)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "test": "mocha tests/test.js --reporter spec",
    "test:package": "node tests/package.js",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Teddy-Zhu/node-auto-launch.git"
  },
  "keywords": [
    "login",
    "launch",
    "node-webkit",
    "electron",
    "boot",
    "login-items"
  ],
  "author": "Donal Linehan",
  "contributors": [
    "Adam Lynch <adam@teamwork.com>",
    "Teddy Zhu <teddyzhu15@gmail.com>"
  ],
  "homepage": "https://github.com/Teddy-Zhu/node-auto-launch",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Teddy-Zhu/node-auto-launch/issues"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "mocha": "^12.0.3"
  },
  "dependencies": {
    "applescript": "^1.0.0",
    "winreg": "1.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
